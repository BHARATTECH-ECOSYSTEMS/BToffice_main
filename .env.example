# Copy to .env.local (never committed) and fill in. Leave a line empty to keep that part switched off.

# Real sign-in through the company backend (all four, or the portal runs its demo)
VITE_API_BASE_URL=
VITE_KEYCLOAK_URL=
VITE_KEYCLOAK_REALM=
VITE_KEYCLOAK_CLIENT_ID=

# Company tool addresses (src/portal/toolLinks.ts); a tool without one shows "Not connected yet"
VITE_WORKSPACE_URL=
VITE_LIBRECHAT_URL=
VITE_HRMS_URL=
VITE_FILE_TRANSFER_URL=
VITE_CODER_INSTALLER_URL=

# The LMS Platform (MERN LMS). When set (and signed in for real), Learning opens it in a new tab instead of the
# portal's own course pages; it signs people in on Keycloak's own page, so no token goes in the link.
VITE_LMS_PLATFORM_URL=
